# Copy this file to .env (same folder) and fill in real values.
# .env is git-ignored. Never commit real secrets.

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=me_be_test;encrypt=true;trustServerCertificate=true;
DB_USERNAME=sa
DB_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379

# Base64 encoded key, at least 256 bits. Generate: openssl rand -base64 32
JWT_SECRET=change-me

# Gmail address + App Password (not the account password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=change-me

CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# VNPay sandbox: https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=change-me
VNPAY_SECRET_KEY=change-me
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/order/create_vnpay

# Where the backend redirects after payment
FRONTEND_URL=http://localhost:3000
# Comma separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
